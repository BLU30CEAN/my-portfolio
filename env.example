# Personal Information
REACT_APP_PERSONAL_NAME=Your Name
REACT_APP_PERSONAL_EMAIL=your.email@example.com
REACT_APP_PERSONAL_PHONE=010-1234-5678
REACT_APP_PERSONAL_ADDRESS=Your Address

# Profile Image
REACT_APP_PROFILE_IMAGE_URL=your-profile-image-url

# Social Links
REACT_APP_GITHUB_URL=https://github.com/yourusername
REACT_APP_LINKEDIN_URL=https://linkedin.com/in/yourusername

# API Keys (if any)
REACT_APP_API_KEY=your-api-key

# Guestbook + Contact webhook (Google Apps Script)
# 동일한 GAS /exec URL 하나에서 action=submitContact / 방명록 페이로드를 모두 처리한다.
REACT_APP_GOOGLE_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/your-web-app-id/exec

# Server (Node/Express) env
GOOGLE_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/your-web-app-id/exec

# ----------------------------------------------------------------------------
# 알림 설정은 GAS "프로젝트 설정 → 스크립트 속성"에 등록한다 (.env 아님).
#   NOTIFY_EMAIL    = 본인 Gmail 주소         (필수, 없으면 메일 알림 X)
#   TG_BOT_TOKEN    = 텔레그램 BotFather 토큰  (선택, 없으면 텔레그램 알림 X)
#   TG_CHAT_ID      = 본인-봇 1:1 chat_id      (선택)
#   SHEET_CONTACT   = Contact 행 저장 시트명   (기본 'contact')
#   SHEET_GUESTBOOK = 방명록 행 저장 시트명     (기본 'guestbook')
# 자세한 절차는 src/utils/googleSheets.ts 하단 주석 참고.
# ----------------------------------------------------------------------------