# =============================================================================
# my-portfolio 환경 변수 템플릿
#
# PUBLIC_URL: .env.development 에서 "" (로컬/E2E). 프로덕션 빌드는 homepage 로 /my-portfolio
# 사용: cp env.example .env  (Windows: copy env.example .env)
# CRA는 REACT_APP_ 접두사만 브라우저에 노출됩니다.
# =============================================================================

# --- Personal (CRA / 프론트) ---
REACT_APP_PERSONAL_NAME=Your Name
REACT_APP_PERSONAL_EMAIL=your.email@example.com
REACT_APP_PERSONAL_PHONE=010-1234-5678
REACT_APP_PERSONAL_ADDRESS=Your Address

# --- Profile & social ---
REACT_APP_PROFILE_IMAGE_URL=/profile.jpg
REACT_APP_GITHUB_URL=https://github.com/yourusername
REACT_APP_LINKEDIN_URL=https://linkedin.com/in/yourusername

# --- API (로컬 Express 서버 사용 시) ---
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_API_KEY=

# --- Guestbook + Contact (Google Apps Script Web App /exec) ---
# 동일 URL에서 action=submitContact / 방명록 페이로드 처리
REACT_APP_GOOGLE_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/your-web-app-id/exec

# --- Server (Node/Express — server/index.js) ---
PORT=5000
FRONTEND_URL=http://localhost:3100
GOOGLE_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/your-web-app-id/exec

# --- GitLab contribution export (scripts/export-gitlab-contributions.mjs) ---
# .env.local 에만 두는 것을 권장 (토큰). 스크립트는 .env.local → .env 순으로 로드
GITLAB_URL=https://git.utopsoft.co.kr
GITLAB_USERNAME=eunjun
GITLAB_TOKEN=
# 사내 자체서명 CA: export 실패 시 1
GITLAB_TLS_INSECURE=

# GAS 코드/배포: scripts/google-apps-script/Code.gs (Apps Script 에 붙여넣기)
# 스크립트 속성 예: SHEET_GUESTBOOK=guestbook_raw, SHEET_STATS=admin_dashboard
# trackVisit → admin_dashboard total_visits (+ 선택 SHEET_VISITS 상세 로그)
# QA_PW 와 동일 값을 REACT_APP_QA_PW 로 설정 (마스킹 해제용)
REACT_APP_QA_PW=your-qa-admin-password

# --- QA dashboard admin (CRA — 브라우저에 포함됨) ---
